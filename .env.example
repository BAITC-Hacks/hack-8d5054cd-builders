# auto: OpenAI -> NVIDIA -> локальная сборка. Ключи не отправляйте в GitHub.
DEMO_MODE=false
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=20

# Получить ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Получить ключ: https://build.nvidia.com (Get API Key)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# DEMO_MODE=true запускает локальный сценарий по умолчанию.
# В приложении можно переключить источник AI для текущей сессии.
